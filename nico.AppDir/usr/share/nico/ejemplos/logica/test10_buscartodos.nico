PROGRAMA test_buscartodos

    VARIABLE ENTERA $long, $long2, $long3, $long4, $long5

BLOQUE PRINCIPAL
    LIMPIARLOGICA
    
    // Hechos
    AGREGARHECHO("padre(juan, pedro)")
    AGREGARHECHO("padre(juan, ana)")
    AGREGARHECHO("padre(pedro, luis)")
    AGREGARHECHO("padre(ana, carlos)")
    AGREGARHECHO("padre(ana, maria)")
    
    // Regla recursiva
    AGREGARREGLA("ancestro(X, Y) SI padre(X, Y)")
    AGREGARREGLA("ancestro(X, Y) SI padre(X, Z), ancestro(Z, Y)")
    
    ESCRIBIR("==============================") SALTO
    ESCRIBIR("TEST - BUSCARTODOS") SALTO
    ESCRIBIR("==============================") SALTO
    
    // Prueba 1: Recolectar hijos de juan
    ESCRIBIR("Prueba 1: Hijos de juan") SALTO
    BUSCARTODOS("X", "padre(juan, X)", $hijos)
    CALCULAR EN $long = LONGITUDLISTA($hijos)
    ESCRIBIR("Cantidad: ") 
    ESCRIBIR("$long") 
    ESCRIBIR(" (esperado: 2)") SALTO
    
    // Prueba 2: Recolectar todos los padres (con duplicados eliminados)
    ESCRIBIR("Prueba 2: Todos los padres (sin duplicados)") SALTO
    BUSCARTODOS("P", "padre(P, H)", $padres)
    CALCULAR EN $long2 = LONGITUDLISTA($padres)
    ESCRIBIR("Cantidad: ") 
    ESCRIBIR("$long2") 
    ESCRIBIR(" (esperado: 3)") SALTO
    
    // Prueba 3: Descendientes de juan (con regla recursiva)
    ESCRIBIR("Prueba 3: Descendientes de juan") SALTO
    BUSCARTODOS("D", "ancestro(juan, D)", $descendientes)
    CALCULAR EN $long3 = LONGITUDLISTA($descendientes)
    ESCRIBIR("Cantidad: ") 
    ESCRIBIR("$long3") 
    ESCRIBIR(" (esperado: 5)") SALTO
    
    // Prueba 4: Consulta sin resultados
    ESCRIBIR("Prueba 4: Consulta sin resultados") SALTO
    BUSCARTODOS("X", "padre(maria, X)", $vacia)
    CALCULAR EN $long4 = LONGITUDLISTA($vacia)
    ESCRIBIR("Cantidad: ") 
    ESCRIBIR("$long4") 
    ESCRIBIR(" (esperado: 0)") SALTO
    
    // Prueba 5: Recolectar con patrón de lista
    ESCRIBIR("Prueba 5: Lista recolectada") SALTO
    BUSCARTODOS("X", "padre(juan, X)", $lista_final)
    CALCULAR EN $long5 = LONGITUDLISTA($lista_final)
    ESCRIBIR("Cantidad: ") 
    ESCRIBIR("$long5") 
    ESCRIBIR(" (esperado: 2)") SALTO
    
    ESCRIBIR("==============================") SALTO
    ESCRIBIR("FIN DEL TEST") SALTO
    ESCRIBIR("==============================") SALTO

    LIMPIARLOGICA
FIN PRINCIPAL
FINAL
