PROGRAMA AckermannOptimizado
FUNCION ENTERA ACKERMANN($m, $n)
    // FÓRMULAS CERRADAS para m <= 3 (instantáneo)
    SI ($m IGUAL 0) ENTONCES
        RETORNAR $n + 1
    FIN SI
    SI ($m IGUAL 1) ENTONCES
        RETORNAR $n + 2
    FIN SI
    SI ($m IGUAL 2) ENTONCES
        RETORNAR 2 * $n + 3
    FIN SI
    SI ($m IGUAL 3) ENTONCES
        // A(3, n) = 2^(n+3) - 3
        VARIABLE ENTERA $potencia = 1
        VARIABLE ENTERA $i = 0
        VARIABLE ENTERA $exponente = $n + 3
        MIENTRAS ($i MENOR $exponente) HACER
            CALCULAR EN $potencia = $potencia * 2
            CALCULAR EN $i = $i + 1
        FIN MIENTRAS
        RETORNAR $potencia - 3
    FIN SI
    
    // PILA MANUAL para m >= 4
    // PERO usa fórmulas cerradas cuando m <= 3
    LISTA ENTERA $pila[10000]
    VARIABLE ENTERA $tope = 0
    VARIABLE ENTERA $n_actual = 0
    VARIABLE ENTERA $m_actual = 0
    VARIABLE ENTERA $resultado_parcial = 0
    VARIABLE ENTERA $potencia = 1
    VARIABLE ENTERA $i = 0
    VARIABLE ENTERA $exponente = 0
    
    CALCULAR EN $pila[$tope] = $m
    CALCULAR EN $tope = $tope + 1
    CALCULAR EN $pila[$tope] = $n
    CALCULAR EN $tope = $tope + 1
    
    MIENTRAS ($tope MAYOR 1) HACER
        CALCULAR EN $tope = $tope - 1
        ASIGNAR EN $n_actual = $pila[$tope]
        CALCULAR EN $tope = $tope - 1
        ASIGNAR EN $m_actual = $pila[$tope]
        
        // *** CLAVE: Si m <= 3, resolver con fórmula cerrada ***
        SI ($m_actual IGUAL 0) ENTONCES
            CALCULAR EN $resultado_parcial = $n_actual + 1
            CALCULAR EN $pila[$tope] = $resultado_parcial
            CALCULAR EN $tope = $tope + 1
        SINO SI ($m_actual IGUAL 1) ENTONCES
            CALCULAR EN $resultado_parcial = $n_actual + 2
            CALCULAR EN $pila[$tope] = $resultado_parcial
            CALCULAR EN $tope = $tope + 1
        SINO SI ($m_actual IGUAL 2) ENTONCES
            CALCULAR EN $resultado_parcial = 2 * $n_actual + 3
            CALCULAR EN $pila[$tope] = $resultado_parcial
            CALCULAR EN $tope = $tope + 1
        SINO SI ($m_actual IGUAL 3) ENTONCES
            // A(3, n) = 2^(n+3) - 3 (calculado inline)
            CALCULAR EN $potencia = 1
            CALCULAR EN $exponente = $n_actual + 3
            CALCULAR EN $i = 0
            MIENTRAS ($i MENOR $exponente) HACER
                CALCULAR EN $potencia = $potencia * 2
                CALCULAR EN $i = $i + 1
            FIN MIENTRAS
            CALCULAR EN $resultado_parcial = $potencia - 3
            CALCULAR EN $pila[$tope] = $resultado_parcial
            CALCULAR EN $tope = $tope + 1
        SINO
            // m >= 4: expandir recursivamente
            SI ($n_actual IGUAL 0) ENTONCES
                CALCULAR EN $pila[$tope] = $m_actual - 1
                CALCULAR EN $tope = $tope + 1
                CALCULAR EN $pila[$tope] = 1
                CALCULAR EN $tope = $tope + 1
            SINO
                CALCULAR EN $pila[$tope] = $m_actual - 1
                CALCULAR EN $tope = $tope + 1
                CALCULAR EN $pila[$tope] = $m_actual
                CALCULAR EN $tope = $tope + 1
                CALCULAR EN $pila[$tope] = $n_actual - 1
                CALCULAR EN $tope = $tope + 1
            FIN SI
        FIN SI
    FIN MIENTRAS
    
    SI ($tope MAYOR 0) ENTONCES
        CALCULAR EN $tope = $tope - 1
        RETORNAR $pila[$tope]
    FIN SI
    RETORNAR 0
FIN FUNCION

BLOQUE PRINCIPAL
    VARIABLE ENTERA $r = 0
    
    ESCRIBIR("=== ACKERMANN CON FÓRMULAS CERRADAS ===") SALTO
    ESCRIBIR("Para m <= 3 usa matemática directa: O(1) o O(n)") SALTO
    ESCRIBIR("") SALTO
    
    ESCRIBIR("A(3, 3) = ")
    CALCULAR EN $r = ACKERMANN(3, 3)
    ESCRIBIR("$r (Esperado: 61)") SALTO
    
    ESCRIBIR("A(3, 6) = ")
    CALCULAR EN $r = ACKERMANN(3, 6)
    ESCRIBIR("$r (Esperado: 509)") SALTO
    

    ESCRIBIR("A(3, 10) = ")
    CALCULAR EN $r = ACKERMANN(3, 10)
    ESCRIBIR("$r (Esperado: 8189)") SALTO
    
    ESCRIBIR("A(3, 20) = ")
    CALCULAR EN $r = ACKERMANN(3, 20)
    ESCRIBIR("$r (Esperado: 8388605)") SALTO
    
    ESCRIBIR("A(4, 0) = ")
    CALCULAR EN $r = ACKERMANN(4, 0)
    ESCRIBIR("$r (Esperado: 13)") SALTO
    
    ESCRIBIR("A(4, 1) = ")
    CALCULAR EN $r = ACKERMANN(4, 1)
    ESCRIBIR("$r (Esperado: 65533)") SALTO
    
    ESCRIBIR("") SALTO
    ESCRIBIR("¡¡INSTANTÁNEO!!") SALTO
FIN PRINCIPAL
FINAL