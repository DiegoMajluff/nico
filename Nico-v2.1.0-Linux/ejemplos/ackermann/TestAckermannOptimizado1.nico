PROGRAMA TestAckermannOptimizado
    // La inicialización a {0} ya pone todo en cero a nivel de C. 
    // No hace falta el bucle de 1 millón de iteraciones.
    LISTA ENTERA SIN SIGNO $cache[1000000] = {0}

    // ENTERA SIN SIGNO para soportar valores hasta 2^64 - 1
    FUNCION ENTERA SIN SIGNO ackermann_mem($m, $n)
        VARIABLE ENTERA SIN SIGNO $res = 0
        VARIABLE ENTERA SIN SIGNO $temp = 0
        VARIABLE ENTERA SIN SIGNO $m_menos_1 = 0
        VARIABLE ENTERA SIN SIGNO $indice = 0
        VARIABLE ENTERA SIN SIGNO $valor_cache = 0
        
        // --- ATAJOS MATEMÁTICOS PARA EVITAR RECURSIÓN ---
        SI($m IGUAL 1) ENTONCES
            RETORNAR $n + 2
        FIN SI
        SI($m IGUAL 2) ENTONCES
            RETORNAR (2 * $n) + 3
        FIN SI
        SI($m IGUAL 3) ENTONCES
            VARIABLE ENTERA SIN SIGNO $potencia = 1
            VARIABLE ENTERA SIN SIGNO $exponente = $n + 3
            VARIABLE ENTERA SIN SIGNO $j = 0
            MIENTRAS($j MENOR $exponente) HACER
                CALCULAR EN $potencia = $potencia * 2
                CALCULAR EN $j = $j + 1
            FIN MIENTRAS
            // Magia del complemento a 2: 
            // Si n=61, exponente=64. 2^64 en unsigned 64-bit es 0.
            // 0 - 3 en unsigned 64-bit es 18446744073709551613. ¡Es correcto!
            RETORNAR $potencia - 3
        FIN SI
        // --------------------------------------------

        // Validación de índice para m >= 4
        CALCULAR EN $indice = ($m * 100000) + $n
        ASIGNAR EN $valor_cache = $cache[$indice]
        
        // Si el valor NO está en caché (es 0)
        SI($valor_cache IGUAL 0) ENTONCES
            SI($m IGUAL 0) ENTONCES
                ASIGNAR EN $res = $n + 1
            SINO
                SI($n IGUAL 0) ENTONCES
                    ASIGNAR EN $res = ackermann_mem($m - 1, 1)
                SINO
                    CALCULAR EN $temp = ackermann_mem($m, $n - 1)
                    CALCULAR EN $m_menos_1 = $m - 1
                    ASIGNAR EN $res = ackermann_mem($m_menos_1, $temp)
                FIN SI
            FIN SI
            
            $cache[$indice] = $res
        SINO
            // Ya está en caché
            ASIGNAR EN $res = $valor_cache
        FIN SI
        
        RETORNAR $res
    FIN FUNCION

    BLOQUE PRINCIPAL
        // CAMBIO CLAVE: Usar SIN SIGNO para las variables que reciben el resultado
        VARIABLE ENTERA SIN SIGNO $r = 0
        VARIABLE ENTERA SIN SIGNO $s = 0
        
        ESCRIBIR("=== ACKERMANN OPTIMIZADO (1) ===") SALTO
        ESCRIBIR("Usando atajos matemáticos y aritmética SIN SIGNO (64-bit)") SALTO
        ESCRIBIR("") SALTO
        
        ESCRIBIR("A(3, 3) = ") 
        CALCULAR EN $r = ackermann_mem(3, 3)
        ESCRIBIR("$r (Esperado: 61)") SALTO
        
        ESCRIBIR("A(3, 4) = ")
        CALCULAR EN $r = ackermann_mem(3, 4)
        ESCRIBIR("$r (Esperado: 125)") SALTO
        
        ESCRIBIR("A(3, 11) = ")
        CALCULAR EN $r = ackermann_mem(3, 11)
        ESCRIBIR("$r (Esperado: 16381)") SALTO

        ESCRIBIR("A(3, 12) = ")
        CALCULAR EN $r = ackermann_mem(3, 12)
        ESCRIBIR("$r (Esperado: 32765)") SALTO

        ESCRIBIR("A(3, 13) = ")
        CALCULAR EN $r = ackermann_mem(3, 13)
        ESCRIBIR("$r (Esperado: 65533)") SALTO

        ESCRIBIR("A(3, 14) = ")
        CALCULAR EN $r = ackermann_mem(3, 14)
        ESCRIBIR("$r (Esperado: 131069)") SALTO

        ESCRIBIR("A(3, 15) = ")
        CALCULAR EN $r = ackermann_mem(3, 15)
        ESCRIBIR("$r (Esperado: 262141)") SALTO

        ESCRIBIR("A(3, 16) = ")
        CALCULAR EN $r = ackermann_mem(3, 16)
        ESCRIBIR("$r (Esperado: 524285)") SALTO

        ESCRIBIR("A(3, 17) = ")
        CALCULAR EN $r = ackermann_mem(3, 17)
        ESCRIBIR("$r (Esperado: 1048573)") SALTO

        ESCRIBIR("A(3, 18) = ")
        CALCULAR EN $r = ackermann_mem(3, 18)
        ESCRIBIR("$r (Esperado: 2097149)") SALTO

        ESCRIBIR("A(3, 19) = ")
        CALCULAR EN $r = ackermann_mem(3, 19)
        ESCRIBIR("$r (Esperado: 4194301)") SALTO

        ESCRIBIR("A(3, 20) = ")
        CALCULAR EN $r = ackermann_mem(3, 20)
        ESCRIBIR("$r (Esperado: 8388605)") SALTO

        ESCRIBIR("A(3, 28) = ")
        CALCULAR EN $r = ackermann_mem(3, 28)
        ESCRIBIR("$r (Esperado: 2147483645)") SALTO

        ESCRIBIR("A(3, 29) = ")
        CALCULAR EN $s = ackermann_mem(3, 29)
        ESCRIBIR("$s (Esperado: 4294967293)") SALTO

        ESCRIBIR("A(3, 30) = ")
        CALCULAR EN $s = ackermann_mem(3, 30)
        ESCRIBIR("$s (Esperado: 8589934589)") SALTO

        ESCRIBIR("A(3, 60) = ")
        CALCULAR EN $s = ackermann_mem(3, 60)
        ESCRIBIR("$s (Esperado: 9223372036854775805)") SALTO

        ESCRIBIR("A(3, 61) = ")
        CALCULAR EN $s = ackermann_mem(3, 61)
        ESCRIBIR("$s (Esperado: 18446744073709551613)") SALTO

        ESCRIBIR("A(4, 0) = ")
        CALCULAR EN $r = ackermann_mem(4, 0)
        ESCRIBIR("$r (Esperado: 13)") SALTO

        ESCRIBIR("A(4, 1) = ")
        CALCULAR EN $s = ackermann_mem(4, 1)
        ESCRIBIR("$s (Esperado: 65533)") SALTO

        ESCRIBIR("") SALTO
        ESCRIBIR("¡¡NICO RESOLVIÓ ACKERMANN INSTANTÁNEAMENTE!!") SALTO
    FIN PRINCIPAL
FINAL
