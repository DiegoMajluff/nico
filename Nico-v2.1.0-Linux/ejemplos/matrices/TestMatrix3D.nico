PROGRAMA TestMultiplesMatrices3D

// Declaración INDIVIDUAL, una por línea (forma correcta)
MATRIZ ENTERA $matriz_a[3][3][3]
MATRIZ ENTERA $matriz_b[3][3][3]
MATRIZ ENTERA $matriz_c[3][3][3]

VARIABLE ENTERA $i, $j, $k
BLOQUE PRINCIPAL
    ESCRIBIR("╔════════════════════════════════════════════════════╗") SALTO
    ESCRIBIR("║  TEST: MÚLTIPLES MATRICES 3D (declaradas aparte)   ║") SALTO
    ESCRIBIR("╚════════════════════════════════════════════════════╝") SALTO
    ESCRIBIR("") SALTO

    // =================================================
    // FASE 1: Llenar cada matriz con valores diferentes
    // =================================================
    ESCRIBIR("--- Fase 1: Llenando matrices ---") SALTO
    ESCRIBIR("matriz_a: valores 1-27 (fórmula: i*100 + j*10 + k)") SALTO
    ESCRIBIR("matriz_b: valores 1000-1027 (fórmula: 1000 + i*100 + j*10 + k)") SALTO
    ESCRIBIR("matriz_c: valores 2000-2027 (fórmula: 2000 + i*100 + j*10 + k)") SALTO
    ESCRIBIR("") SALTO

    PARA($i DESDE 0 HASTA 2) HACER
        PARA($j DESDE 0 HASTA 2) HACER
            PARA($k DESDE 0 HASTA 2) HACER
                ASIGNAR EN $matriz_a[$i][$j][$k] = ($i * 100) + ($j * 10) + $k
                ASIGNAR EN $matriz_b[$i][$j][$k] = 1000 + ($i * 100) + ($j * 10) + $k
                ASIGNAR EN $matriz_c[$i][$j][$k] = 2000 + ($i * 100) + ($j * 10) + $k
            FIN PARA
        FIN PARA
    FIN PARA
    ESCRIBIR("Las 3 matrices fueron llenadas correctamente.") SALTO
    ESCRIBIR("") SALTO

    // ====================================================
    // FASE 2: Verificar valores específicos de cada matriz
    // ====================================================
    ESCRIBIR("--- Fase 2: Verificación de valores específicos ---") SALTO
    ESCRIBIR("") SALTO

    ESCRIBIR("matriz_a[0][0][0] = $matriz_a[0][0][0] (esperado: 0)") SALTO
    ESCRIBIR("matriz_b[0][0][0] = $matriz_b[0][0][0] (esperado: 1000)") SALTO
    ESCRIBIR("matriz_c[0][0][0] = $matriz_c[0][0][0] (esperado: 2000)") SALTO
    ESCRIBIR("") SALTO

    ESCRIBIR("matriz_a[1][1][1] = $matriz_a[1][1][1] (esperado: 111)") SALTO
    ESCRIBIR("matriz_b[1][1][1] = $matriz_b[1][1][1] (esperado: 1111)") SALTO
    ESCRIBIR("matriz_c[1][1][1] = $matriz_c[1][1][1] (esperado: 2111)") SALTO
    ESCRIBIR("") SALTO

    ESCRIBIR("matriz_a[2][2][2] = $matriz_a[2][2][2] (esperado: 222)") SALTO
    ESCRIBIR("matriz_b[2][2][2] = $matriz_b[2][2][2] (esperado: 1222)") SALTO
    ESCRIBIR("matriz_c[2][2][2] = $matriz_c[2][2][2] (esperado: 2222)") SALTO
    ESCRIBIR("") SALTO

    // =================================================
    // FASE 3: Mostrar contenido completo de cada matriz
    // =================================================
    ESCRIBIR("--- Fase 3: Contenido completo de matriz_a ---") SALTO
    PARA($i DESDE 0 HASTA 2) HACER
        ESCRIBIR("Plano $i:") SALTO
        PARA($j DESDE 0 HASTA 2) HACER
            ESCRIBIR("  Fila $j: ") SALTO
            PARA($k DESDE 0 HASTA 2) HACER
                ESCRIBIR("$matriz_a[$i][$j][$k] ") SALTO
            FIN PARA
            ESCRIBIR("") SALTO
        FIN PARA
        ESCRIBIR("") SALTO
    FIN PARA

    ESCRIBIR("--- Fase 4: Contenido completo de matriz_b ---") SALTO
    PARA($i DESDE 0 HASTA 2) HACER
        ESCRIBIR("Plano $i:") SALTO
        PARA($j DESDE 0 HASTA 2) HACER
            ESCRIBIR("  Fila $j: ") SALTO
            PARA($k DESDE 0 HASTA 2) HACER
                ESCRIBIR("$matriz_b[$i][$j][$k] ") SALTO
            FIN PARA
            ESCRIBIR("") SALTO
        FIN PARA
        ESCRIBIR("") SALTO
    FIN PARA

    ESCRIBIR("--- Fase 5: Contenido completo de matriz_c ---") SALTO
    PARA($i DESDE 0 HASTA 2) HACER
        ESCRIBIR("Plano $i:") SALTO
        PARA($j DESDE 0 HASTA 2) HACER
            ESCRIBIR("  Fila $j: ") SALTO
            PARA($k DESDE 0 HASTA 2) HACER
                ESCRIBIR("$matriz_c[$i][$j][$k] ") SALTO
            FIN PARA
            ESCRIBIR("") SALTO
        FIN PARA
        ESCRIBIR("") SALTO
    FIN PARA

    ESCRIBIR("╔════════════════════════════════════════════════════╗") SALTO
    ESCRIBIR("║  FIN DEL TEST                                      ║") SALTO
    ESCRIBIR("╚════════════════════════════════════════════════════╝") SALTO
FIN PRINCIPAL
FINAL
