PROGRAMA test06_corte

BLOQUE PRINCIPAL

    LIMPIARLOGICA

    // Hechos

    AGREGARHECHO("color(rojo)")
    AGREGARHECHO("color(verde)")
    AGREGARHECHO("color(azul)")

    // Regla con corte

    AGREGARREGLA("primer_color(X) :- color(X), !")

    ESCRIBIR("==============================") SALTO
    ESCRIBIR("TEST 6 - CORTE") SALTO
    ESCRIBIR("==============================") SALTO 

    ESCRIBIR("Prueba 1: color(X)") SALTO
    CONSULTAR("color(X)")
    
    ESCRIBIR("Prueba 2: primer_color(X)") SALTO
    CONSULTAR("primer_color(X)")
    
    ESCRIBIR("Prueba 3: primer_color(rojo)") SALTO
    CONSULTAR("primer_color(rojo)")
    
    ESCRIBIR("Prueba 4: primer_color(verde)") SALTO
    CONSULTAR("primer_color(verde)")
    
    ESCRIBIR("Prueba 5: primer_color(azul)") SALTO
    CONSULTAR("primer_color(azul)")
    
    LIMPIARLOGICA

FIN PRINCIPAL
FINAL
